# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (local: postgres://user:pass@host:port/dbname).
# Production (e.g. Neon): postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URI=postgresql://user:password@localhost:5432/your_db_name

# -----------------------------------------------------------------------------
# Payload CMS
# -----------------------------------------------------------------------------
# Secret key for signing JWTs, cookies, and encrypting sensitive values. Use a long random string.
PAYLOAD_SECRET=replace_with_a_long_random_string

# -----------------------------------------------------------------------------
# Public site URL (no trailing slash)
# -----------------------------------------------------------------------------
# Browser-visible base URL: CORS, redirects, image optimization checks, and API calls from the frontend.
# Local dev is usually http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# On Vercel, set to your production hostname only (no https://). next.config.js builds the full URL.
# Example: my-app.vercel.app
# VERCEL_PROJECT_PRODUCTION_URL=my-app.vercel.app

# Often set in Vercel to the same value as NEXT_PUBLIC_SERVER_URL for CMS / deployment docs.
# NEXT_PUBLIC_PAYLOAD_URL=https://your-domain.com
# PAYLOAD_PUBLIC_SERVER_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Vercel Blob (media uploads via @payloadcms/storage-vercel-blob)
# -----------------------------------------------------------------------------
# Read-write token from the Vercel Blob store dashboard (used in payload.config.ts).
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Public base URL for generated media URLs (from Vercel Blob store settings).
VERCEL_BLOB_BASE_URL=https://YOUR_STORE_ID.public.blob.vercel-storage.com

# Optional alias some docs reference; keep in sync with VERCEL_BLOB_READ_WRITE_TOKEN if your tooling expects it.
# NEW_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
